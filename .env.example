# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------
# Vercel dashboard -> Storage -> Neon injects this automatically. Locally, copy
# the POOLED connection string from the Neon console. It is also needed in
# Vercel's BUILD environment, not just at runtime: generateStaticParams queries
# the database while prerendering /works/[id].
DATABASE_URL=

# The DIRECT (unpooled) connection string, used only by drizzle-kit for DDL.
# Optional — falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Object storage — Cloudflare R2
# ---------------------------------------------------------------------------
# R2 dashboard -> Overview (account id is in the right-hand sidebar / the S3
# API endpoint), then Manage API tokens -> Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public delivery domain for the bucket, no trailing slash.
#
# Today: the bucket's Public Development URL (bucket -> Settings -> Public
# access), https://pub-<hash>.r2.dev. Cloudflare rate-limits it and does not
# intend it for production traffic, so before launch this should become a
# custom domain (https://cdn.matildecrisp.com) — which requires moving the
# zone's DNS to Cloudflare, since R2 creates that record itself. Namecheap
# still holds the registration either way; only the nameservers change.
#
# Switching is this one variable: the database stores object KEYS, not URLs,
# and next.config.ts derives its allowed image host from this value.
R2_PUBLIC_URL=

# The bucket needs a CORS rule allowing PUT from every origin the admin is
# used from (bucket -> Settings -> CORS policy). Origin matching is exact, so
# both localhost ports and both www variants are listed:
#   AllowedOrigins: ["http://localhost:3000", "http://localhost:3001",
#                    "https://matildecrisp.com", "https://www.matildecrisp.com"]
#   AllowedMethods: ["PUT"]
#   AllowedHeaders: ["content-type"]
#   ExposeHeaders:  ["etag"]
#   MaxAgeSeconds:  3600
#
# CORS governs uploads only. Serving files publicly is the separate "Public
# access" setting — miss it and uploads succeed while every image 404s.

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# The shared password for /admin.
ADMIN_PASSWORD=
# Random secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
# Changing either value logs everyone out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Notion — LEGACY. The site no longer reads Notion; these are only needed to
# re-run scripts/migrate-from-notion.ts, which is kept as a record of the
# original field mapping. Safe to delete once you are confident.
# ---------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_ABOUT_DB_ID=
NOTION_EDUCATION_DB_ID=
NOTION_EXPERIENCE_DB_ID=
NOTION_WORKS_DB_ID=
